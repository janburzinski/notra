set -eu

files=$(mktemp)
trap 'rm -f "$files"' EXIT
trap 'exit 1' HUP INT TERM

git diff --cached --name-only --diff-filter=ACMR -z -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' \
  '*.json' '*.jsonc' '*.css' '*.scss' '*.less' '*.html' '*.vue' '*.svelte' > "$files"

if [ -s "$files" ]; then
  xargs -0 sh -c '
    for file do
      if ! git --literal-pathspecs diff --quiet -- "$file"; then
        printf "Cannot format partially staged file: %s\nStage the entire file, or unstage it before committing.\n" "$file" >&2
        exit 255
      fi
    done
  ' sh < "$files"

  xargs -0 bun x --no-install oxlint --fix --threads=4 --no-error-on-unmatched-pattern -- < "$files"
  xargs -0 bun x --no-install oxfmt --write --no-error-on-unmatched-pattern -- < "$files"

  git --literal-pathspecs add --pathspec-from-file="$files" --pathspec-file-nul
fi

# apps/blog/scripts/web-chrome.js is bundled from these sources; CI fails when it is stale.
chrome_sources='apps/web packages/ui packages/utils bun.lock'
chrome_outputs='apps/blog/scripts/web-chrome.js apps/blog/public/licenses/web-chrome.txt'
# shellcheck disable=SC2086
if ! git diff --cached --quiet -- $chrome_sources; then
  # Unstaged edits in either place would be bundled or overwritten.
  # shellcheck disable=SC2086
  if git diff --quiet -- $chrome_sources $chrome_outputs; then
    # No env file: CI builds it without one, and the bundle ships publicly.
    (cd apps/web && bun --no-env-file run blog:chrome > /dev/null)
    # shellcheck disable=SC2086
    git add $chrome_outputs
  else
    printf "Not regenerating apps/blog/scripts/web-chrome.js: unstaged changes under %s %s.\nRun bun run blog:chrome in apps/web before pushing.\n" "$chrome_sources" "$chrome_outputs" >&2
  fi
fi

bun knip
