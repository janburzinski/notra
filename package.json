{
  "name": "turbo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/devtools": "1.0.32",
      "@ai-sdk/gateway": "4.0.105",
      "@aws-sdk/client-s3": "^3.1152.0",
      "@base-ui/react": "^1.9.0",
      "@databuddy/sdk": "3.4.2",
      "@dnd-kit/core": "^6.3.1",
      "@dnd-kit/sortable": "^10.0.0",
      "@electric-sql/pglite": "0.5.8",
      "@hugeicons/core-free-icons": "^4.3.5",
      "@hugeicons/react": "^1.1.10",
      "@tanstack/react-form": "^1.33.5",
      "@types/react-dom": "^19.3.0",
      "@types/sanitize-html": "^2.16.2",
      "@upstash/ratelimit": "^2.2.0",
      "@upstash/redis": "^1.39.0",
      "@vercel/oidc": "^3.8.10",
      "ai": "7.0.129",
      "autumn-js": "~1.2.56",
      "bun-types": "1.4.4",
      "dotenv-cli": "^11.0.0",
      "drizzle-orm": "^0.45.4",
      "echarts": "^6.1.0",
      "effect": "4.1.0",
      "evlog": "2.28.1",
      "lucide-react": "^0.562.0",
      "nanoid": "^5.1.16",
      "next-themes": "^0.4.6",
      "sanitize-html": "^2.18.1",
      "satori": "^0.33.5",
      "sonner": "^2.0.8",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "7.0.2",
      "zod": "^4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "check-types": "dotenv -- turbo run check-types",
    "test": "node --test scripts/github/production-deploy.test.mjs scripts/github/utils/release-gates.test.mjs && turbo run test",
    "sites:e2e": "bun --no-env-file run --cwd apps/sites-e2e test:e2e",
    "sites:e2e:cleanup": "bun --no-env-file run --cwd apps/sites-e2e test:cleanup",
    "sites:e2e:dashboard": "bun --no-env-file scripts/testing/dashboard/run.ts",
    "knip": "dotenv -- turbo run knip --filter=web --filter=dashboard --filter=api --filter=console",
    "db:generate": "dotenv -- bunx drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "turbo run check:migrations --filter=@notra/db --",
    "db:migrate": "dotenv -- bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:push": "dotenv -- bunx drizzle-kit push --config packages/db/drizzle.config.ts",
    "db:studio": "dotenv -- bunx drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:drop": "dotenv -- bunx drizzle-kit drop --config packages/db/drizzle.config.ts",
    "db:pull": "dotenv -- bunx drizzle-kit pull --config packages/db/drizzle.config.ts",
    "evals": "bun --cwd apps/evals src/index.tsx",
    "devtools:api": "cd apps/api && bunx @ai-sdk/devtools",
    "devtools:dashboard": "cd apps/dashboard && bunx @ai-sdk/devtools",
    "check": "bun run check:effect && ultracite check --threads=4",
    "check:effect": "oxlint --config oxlint.effect.config.ts apps/api/src apps/console/src apps/dashboard/src apps/web/src apps/agent/agent apps/onboarding-agent/agent packages/ai/src packages/analytics/src packages/db/src packages/geo-core/src packages/schemas/src packages/sites-server/src packages/tools/src packages/webhooks/src --threads=2",
    "format": "ultracite fix --threads=4",
    "format:unsafe": "ultracite fix --unsafe --threads=4",
    "commitlint": "commitlint",
    "prepare": "husky && ./scripts/prepare-effect.sh && effect-tsgo patch --typescript --oxlint",
    "brew:setup": "dotenv -- bun packages/email/scripts/brew-setup.ts",
    "brew:test-send": "dotenv -- bun packages/email/scripts/brew-test-send.tsx",
    "brew:previews": "dotenv -- bun packages/email/scripts/brew-previews.tsx"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/tsgo": "0.47.2",
    "@shadcn/lint": "0.1.0",
    "@types/node": "24.13.6",
    "bun-types": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.12.2",
    "openlogs": "~0.0.4",
    "oxfmt": "0.64.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.10.8"
  },
  "overrides": {
    "@modelcontextprotocol/sdk@1": "1.32.1",
    "adm-zip": "0.6.1",
    "axios@1": "1.20.0",
    "body-parser@1": "1.20.9",
    "body-parser@2": "2.4.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "decode-uri-component": "0.5.1",
    "devalue@5": "5.9.4",
    "dompurify": "3.4.17",
    "follow-redirects@1": "1.16.2",
    "hono": "4.13.13",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lodash-es@4": "4.18.1",
    "mdast-util-to-markdown": "2.1.2",
    "nanoid@3": "3.3.20",
    "nanoid@4": "5.1.16",
    "nanoid@5": "5.1.16",
    "nf3": "0.3.17",
    "path-to-regexp@6": "6.3.0",
    "protobufjs@7": "7.6.5",
    "re2js": "2.8.7",
    "react-is": "19.2.8",
    "seroval": "1.6.11",
    "sharp": "^0.35.5",
    "systeminformation@5": "5.33.16",
    "tinypool": "2.1.2",
    "undici@7": "7.30.1",
    "undici@8": "8.12.2",
    "zod@4": "4.6.7"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@workflow/builders@4.1.13": "patches/@workflow%2Fbuilders@4.1.13.patch",
    "@workflow/nitro@4.1.14": "patches/@workflow%2Fnitro@4.1.14.patch",
    "@tanstack/start-plugin-core@1.171.49": "patches/@tanstack%2Fstart-plugin-core@1.171.49.patch",
    "eve@0.58.1": "patches/eve@0.58.1.patch",
    "nuqs@2.10.2": "patches/nuqs@2.10.2.patch"
  }
}
