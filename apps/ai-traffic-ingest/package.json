    "@notra/db": "workspace:*",
    "@notra/geo-core": "workspace:*",
    "@notra/web-tracker": "workspace:*",
    "hono": "^4.13.13",
    "mmdb-lib": "3.0.2"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "typescript": "catalog:"
  }
}
