---
import CtaBanner from "./cta-banner.astro";
import ExampleHeights from "./example-heights.astro";
import SidebarMemory from "./sidebar-memory.astro";
import ThemeHotkey from "./theme-hotkey.astro";
---

<footer class="w-full px-(--notra-gutter) pt-16 pb-8 lg:ps-[calc(var(--notra-sidebar-width)+var(--notra-gutter))] xl:pe-[calc(15rem+var(--notra-gutter))]">
  <CtaBanner />
  <p class="mt-16 border-t border-(--blume-border) pt-6 text-xs text-(--blume-muted-foreground)">
    Google, OpenAI, Anthropic, Perplexity and the other brands shown are trademarks of their respective owners. Notra is not affiliated with any of them.{" "}
    <a class="underline underline-offset-2 hover:text-(--blume-foreground)" href="/trademarks">Trademarks</a>
  </p>
</footer>
<ThemeHotkey />
<SidebarMemory />
<ExampleHeights />
