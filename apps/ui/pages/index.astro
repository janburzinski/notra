---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";

import CtaBanner from "../src/components/cta-banner.astro";
import LandingCollage from "../src/components/landing-collage.astro";
import NotraSidebar from "../src/components/notra-sidebar.astro";
import ThemeHotkey from "../src/components/theme-hotkey.astro";

const { config, navigation } = data;
const repoUrl = config.repoUrl ?? "https://github.com/usenotra";
---

<PageLayout
  analytics={config.analytics}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={navigation}
  page={{
    description: config.description,
    route: "/",
    title: "Notra UI: the components behind Notra",
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  themeMode={config.theme.mode}
>
  <div class="grid grid-cols-1 items-start lg:grid-cols-[var(--notra-sidebar-width)_minmax(0,1fr)]" data-notra-home>
    <aside
      aria-label="Documentation"
      class="sticky top-16 hidden h-[calc(100dvh-4rem)] overflow-y-auto [scrollbar-width:thin] lg:block"
      data-notra-sidebar
    >
      <nav data-blume-nav-tree>
        <NotraSidebar currentRoute="/" items={navigation.sidebar} />
      </nav>
    </aside>

    <div class="min-w-0 px-2 pt-2 pb-2 lg:ps-0">
      <LandingCollage repoUrl={repoUrl} />
      <div class="pt-2">
        <CtaBanner />
      </div>
    </div>
  </div>
  <ThemeHotkey slot="footer" />
</PageLayout>
