# Database (shared with the Notra dashboard)
DATABASE_URL=

# Redis (required in production for shared rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App URL
CONSOLE_APP_URL="http://localhost:3003"

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ chars
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_DOMAIN=
CONSOLE_WORKOS_REDIRECT_URI="http://localhost:3003/auth/callback"
# Register the console initiate-login URI as http://localhost:3003/auth/sign-in.

# Encryption (base64-encoded 32 bytes, `openssl rand -base64 32`)
INTEGRATION_ENCRYPTION_KEY=

# Autumn Billing
AUTUMN_SECRET_KEY=

# Cloudflare R2 (integration branding uploads)
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_S3_ENDPOINT=
CLOUDFLARE_PUBLIC_URL=
CLOUDFLARE_BUCKET_NAME=

# context.dev Logo Link (GEO report logos; frontend-safe client id from context.dev/dashboard/logolink)
NEXT_PUBLIC_LOGOLINK_CLIENT_ID=

# Vercel AI Gateway (GEO scan; server-side)
AI_GATEWAY_API_KEY=

# context.dev (competitor lookup; server-side)
CONTEXT_DEV_API_KEY=

# Notra Sites admin
# Sites R2 bucket (same values as the dashboard; live build logs and serving state)
SITES_R2_ACCOUNT_ID=
SITES_R2_ACCESS_KEY_ID=
SITES_R2_SECRET_ACCESS_KEY=
SITES_R2_BUCKET=
# Dashboard origin and shared secret for /api/internal/sites/admin (builds, rollbacks, suspend, Tinybird stats).
# Locally the dashboard accepts loopback requests without the secret.
NOTRA_DASHBOARD_URL="http://localhost:3000"
INTERNAL_WORKFLOW_SECRET=
