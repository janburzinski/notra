{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/remotion/index.ts",
    "remotion.config.ts",
    "src/router.tsx",
    "src/start.ts",
    "middleware.ts",
    "scripts/fonts/verify.mjs",
    "src/embed/blog-chrome/{entry,router}.tsx",
    "src/routes/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/inter",
    "@fontsource/instrument-serif"
  ],
