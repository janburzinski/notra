---
import type { CustomChromeProps as Props } from "../types/site-files";
import { chromeComponent } from "../lib/site-files";
import { params } from "../lib/params";
import PoweredByNotra from "./PoweredByNotra.astro";
import ReportAbuseLink from "./ReportAbuseLink.astro";

const { part, context } = Astro.props;
const Component = chromeComponent(part);
const isFooter = part === "footer";
---

{
  Component && (
    <div data-custom-chrome={part}>
      <Component {...context} />
      {isFooter && (
        <div class="flex items-center justify-end gap-4 border-t border-border px-5 py-3 sm:px-6">
          <ReportAbuseLink />
          {params.branding && <PoweredByNotra />}
        </div>
      )}
    </div>
  )
}
