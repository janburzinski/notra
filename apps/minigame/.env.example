# Public origin of the game; X's callback URL must be exactly <MINIGAME_URL>/auth/x/callback.
MINIGAME_URL=""
# OAuth 2.0 client of the game's own X app (confidential client, scopes tweet.read users.read).
MINIGAME_X_CLIENT_ID=""
MINIGAME_X_CLIENT_SECRET=""
# X user ids (comma separated) that may remove and ban players from the leaderboard.
MINIGAME_ADMIN_IDS=""
# At least 32 random characters; signs the session and sign-in cookies.
MINIGAME_SESSION_SECRET=""
# Leaderboard and runs. Without them, development keeps everything in memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Dev only: keep scores in memory even when Upstash is configured.
# MINIGAME_MEMORY_STORE="true"
# Dev only: on localhost without X keys you play as @devpilot and scores save right away.
# Set to off to try the guest flow; /auth/dev?handle=you switches to another dev player.
# MINIGAME_DEV_PLAYER="off"
