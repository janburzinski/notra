{
  "name": "@notra/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./constants/*": "./src/constants/*.ts",
    "./drizzle": "./src/drizzle.ts",
    "./drizzle-http": "./src/drizzle-http.ts",
    "./schema": "./src/schema.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "check:migrations": "bun run src/scripts/check-migrations.ts",
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "bun test tests",
    "seed:brand-identity": "bun run src/scripts/seed-brand-identity.ts",
    "seed:chat-attachments": "bun run src/scripts/seed-chat-attachments.ts",
    "seed:persona-visibility": "bun run src/scripts/seed-persona-visibility.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@notra/memory": "workspace:*",
    "@notra/sites-core": "workspace:*",
    "@notra/utils": "workspace:*",
    "@notra/workflows": "workspace:*",
    "@upstash/redis": "catalog:",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
